# Port for the web pairing panel (most hosts set this for you)
PORT=3000
# Owner number, digits only with country code
OWNER_NUMBER=255695415218
# Max linked WhatsApp accounts
MAX_SESSIONS=1000
# Sessions database (Postgres). On Railway: add a Postgres service, then in this
# service's Variables add  DATABASE_URL = ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# ── Auto-deploy from GitHub (webhook) ──
# GitHub repo → Settings → Webhooks → Add webhook
#   Payload URL:  https://YOUR-APP-URL/api/github/webhook
#   Content type: application/json     Secret: same value as below     Event: Just the push event
UPDATE_REPO=yourname/prince
UPDATE_BRANCH=main
GITHUB_WEBHOOK_SECRET=
# Heroku only (so the webhook can trigger a build):
HEROKU_APP_NAME=
HEROKU_API_KEY=

# ── Human check (Cloudflare Turnstile, free) ──
# dash.cloudflare.com → Turnstile → Add widget (add every server hostname). Leave empty = check OFF.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
